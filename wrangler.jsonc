{
  // CULT ($CULT) on Meteora: site + API + buy-refund watcher + airdrop cron. Not deployed yet (waiting on the green light).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cult-meteora",
  // Live at cults.bid (moved from Kay's earlier "cult" Worker on 2026-11-21; that Worker is left as it was).
  "routes": [{ "pattern": "cults.bid", "custom_domain": true }],
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*", "/", "/index.html"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cult-mainnet",
      // Created 2026-11-21 for the Meteora mainnet launch.
      "database_id": "c377e226-f681-45ff-a273-f8382f145065",
      "migrations_dir": "migrations"
    }
  ],
  // Every minute: open the airdrop for each 10-minute round, then snapshot -> swap -> allocate -> pay, one step at a time.
  "triggers": { "crons": ["* * * * *"] },
  // Signing a few hundred payout transactions takes a while. The refund watcher runs ~55s of each minute (mostly waiting).
  "limits": { "cpu_ms": 120000 },
  "vars": {
    "TICKER": "CULT",
    // Coin mint. Empty until launch: the Buy button and live data switch on when it's set.
    "MINT": "",
    // 10% on every trade (Meteora), in SOL. Buys are refunded in full; sells fund the airdrop.
    "FEE_BPS": "1000",
    // Meteora launch (buy refunds, Meteora copy on the site) even before VAULTS is set.
    "VENUE": "meteora",
    "DROP_MINUTES": "10",
    // Wallets below this USD value are skipped, which keeps USDC account rent under control.
    "MIN_HOLD_USD": "50",
    // Hold this many days without selling for a bigger share: days:multiplier.
    "STREAKS": "7:1.25,30:1.5",
    "X_HANDLE": "thecultponzi",
    // "1" serves generated sample data for review. Off: the live site shows the pre-launch state until MINT is set.
    "DEMO": "0",

    // ---- Meteora launch (all three printed by scripts/launch-meteora.mjs) ----
    // The bonding curve pool, and its "<base vault>:<quote vault>". The DAMM v2 pool after graduation is found automatically.
    "POOL_ACCOUNT": "",
    "VAULTS": "",
    // The treasury: earns the fees, refunds buyers, swaps to USDC and pays holders. Its key is the PAYOUT_SECRET_KEY secret.
    "PAYOUT_WALLET": "",
    // SOL kept back in the treasury for instant refunds between fee claims (0.5 SOL).
    "REFUND_FLOAT_LAMPORTS": "500000000",
    // Comma-separated wallets that never get airdrops (team, treasury, CEX wallets).
    "EXCLUDE": "",
    // "1" runs every step without signing or sending anything. Set "0" to go live.
    "DRY_RUN": "1",
    // SOL always kept in the payout wallet for fees (0.05 SOL).
    "SOL_RESERVE_LAMPORTS": "50000000",
    // Payouts smaller than this roll into the next airdrop.
    "MIN_PAYOUT_USDC": "0.01",
    // Wallets paid per transaction (8 fits under Solana's size limit even when opening their USDC accounts).
    "BATCH_SIZE": "8",
    "SLIPPAGE_BPS": "100",
    "JUP_API": "https://lite-api.jup.ag"
  },
  // Secrets: SOLANA_RPC_URL (Helius key or URL), HELIUS_WEBHOOK_SECRET, PAYOUT_SECRET_KEY, JUP_API_KEY (optional)

  // `wrangler deploy --env devnet`: the devnet launch on Meteora's bonding curve (scripts/launch-meteora.mjs, tiny
  // market caps so it can graduate). Buys refunded for real; airdrops in a stand-in USDC (no Jupiter on devnet).
  "env": {
    "devnet": {
      "name": "paper-hands-devnet",
      "routes": [],
      "workers_dev": true,
      "d1_databases": [{ "binding": "DB", "database_name": "paper-hands-devnet-meteora", "database_id": "2c2f23cb-d5ce-4656-ae8e-ce4542e2b76c", "migrations_dir": "migrations" }],
      "triggers": { "crons": ["* * * * *"] },
      "vars": {
        "CLUSTER": "devnet",
        "X_HANDLE": "",
        "POOL_ACCOUNT": "ELY4npxK6fYunq28Vm4JfPma85ARcW7aAg5xHG33NkJh",
        "VAULTS": "75fsZKQoTw4uTZW5w36qHVXMELqqhK4HcueYAQesMXW9:CRqoNrVSJ5cbwPz7TpZah3tGgAcDjE93eTQJ2zc5Hugn",
        "EXCLUDE": "",
        "TICKER": "CULT",
        "MINT": "EPZ4DMTfVdRHDk7dZepBm5DkpW2gNUZa5uXxicPya49u",
        "PAYOUT_WALLET": "GCpRo9fhAho6XhCrihAjgMz9WNiTB5Z6mYtFtmnYEBbc",
        // api.devnet.solana.com blocks Cloudflare IPs. These two free endpoints don't (tried in order, failover on 429/403).
        "SOLANA_RPC_URL": "https://solana-devnet.g.alchemy.com/v2/demo,https://solana-devnet.api.onfinality.io/public",
        // Free RPCs can't do holder snapshots, so holders come from our own index of the mint's history.
        "HOLDERS": "index",
        "POLL_GAP_MS": "150",
        "POLL_PAGE": "100",
        "FEE_BPS": "1000",
    // Meteora launch (buy refunds, Meteora copy on the site) even before VAULTS is set.
    "VENUE": "meteora",
        // Small float on devnet (the wallets only hold a few tenths of a SOL).
        "REFUND_FLOAT_LAMPORTS": "20000000",
        "DROP_MINUTES": "10",
        "MIN_HOLD_USD": "1",
        "STREAKS": "7:1.25,30:1.5",
        "DEMO": "0",
        // Real payouts on devnet, in a stand-in USDC (scripts/devnet-test-usdc.mjs). No Jupiter on devnet, so no swap:
        // the pot is whatever test USDC the payout wallet holds.
        "DRY_RUN": "0",
        "SWAP": "off",
        "USDC_MINT": "56EvddarourfZET4VC6EMYKwyG7uLWbBdxtcetmp1k5e",
        "SOL_RESERVE_LAMPORTS": "10000000",
        "MIN_PAYOUT_USDC": "0.01",
        "BATCH_SIZE": "8",
        "SLIPPAGE_BPS": "100",
        "JUP_API": "https://lite-api.jup.ag"
      }
    }
  }
}
